# Copia a .env y rellena. NO subas .env al repo.
# Acepta tanto `postgresql+psycopg://` como el `postgres://` que entregan los
# servicios administrados: la URL se normaliza al arrancar (ver app/db.py).
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/tfg
# Quien puede llamar a la API desde el navegador. En local, el servidor de
# desarrollo de Vite; desplegado, la URL del sitio. Varias se separan con coma.
ORIGENES_PERMITIDOS=http://localhost:5173
# Clave de la API de Gemini (consíguela en aistudio.google.com).
# Si tenés una key con BILLING habilitado, va acá (la primaria): el Context
# Caching solo se crea en el proyecto del cliente que se usa, así que en la de
# respaldo no serviría. Reiniciá el backend al cambiarla.
GEMINI_API_KEY=...
# Opcional: clave de un SEGUNDO proyecto de Google Cloud, con billing
# habilitado, usada como respaldo SOLO si la de arriba agota su cuota (429).
# Debe ser un proyecto DISTINTO (la cuota gratis es por proyecto, no por key:
# una segunda key del MISMO proyecto no ayuda). Si la dejás vacía o sin
# definir, un 429 agotado simplemente se propaga como antes (sin respaldo).
GEMINI_API_KEY_RESPALDO=
# Modelo del CHAT (preguntas adaptativas, alto volumen). gemini-3.1-flash-lite
# tiene una cuota gratuita amplia (~500/día). Verifica tus límites en
# aistudio.google.com y ajusta si tu cuenta usa otro.
GEMINI_MODEL=gemini-3.1-flash-lite
# Modelo de los RESULTADOS que el alumno lee (análisis final, simulador,
# comparador; 1 llamada c/u). Comparte gemini-3.1-flash-lite: misma cuota
# amplia (~500/día) y evita agotar pools separados de 20/día.
GEMINI_MODEL_FINAL=gemini-3.1-flash-lite

# --- Test de Holland (O*NET Web Services) ---
# API key de desarrollador, gratis en:
# https://services.onetcenter.org/developer/signup
# Es UNA sola línea (no hay usuario ni contraseña: viaja en el header X-API-Key).
# Sin ella, /api/holland/preguntas responde 503 y el resto de la app sigue igual.
ONET_API_KEY=

# --- Login con Google (OBLIGATORIO para evaluarse) ---
# Client ID de un proyecto OAuth de Google Cloud (console.cloud.google.com >
# APIs & Services > Credentials > OAuth client ID > Web application). El mismo
# valor va también en el frontend (VITE_GOOGLE_CLIENT_ID, frontend/.env). Sin
# esto, /api/auth/google responde 503 y NADIE puede evaluarse: el chat y los
# tests exigen sesión iniciada (ver backend/app/cuota.py).
GOOGLE_CLIENT_ID=
# Clave para firmar los JWT de sesión propios (no la de Google). Cualquier
# cadena larga y aleatoria; ej. generarla con `python -c "import secrets;
# print(secrets.token_hex(32))"`. Cambiarla invalida todas las sesiones activas.
SESSION_SECRET=

# --- Límites de uso (app/cuota.py) ---
# Chats que un mismo alumno puede terminar en 24 horas, en ventana deslizante
# (no día calendario). Solo se limita el chat, que es lo único que gasta Gemini;
# el test de Holland lo califica O*NET y no tiene límite.
# 0 = sin límite, para desarrollo local: deja probar el flujo completo varias
# veces seguidas sin esperar. En producción se deja en 3 (o se omite, que es el
# default del código).
MAX_CHATS_DIARIOS=3
# Freno de emergencia: tokens de Gemini que puede gastar TODA la app en un día
# UTC. Al llegar al tope, los endpoints que gastan responden 429 hasta el día
# siguiente. El default alcanza para unas 200 evaluaciones completas; subirlo o
# bajarlo según el crédito real (ver decisions/gemini-costos-y-caching.md).
TOPE_TOKENS_DIARIO=2000000

# EXPERIMENTAL, apagado. Con 1, el catálogo llega a la recomendación ORDENADO por
# afinidad entre los puntajes RIASEC del alumno y el vector de cada carrera
# (data/holland_catalogo.json, codificado desde O*NET). Medido: NO mueve el top-1
# con la conversación presente — ver experiments/holland-estructura.md.
HOLLAND_EN_RECOMENDACION=0
# Cuántas carreras deja pasar ese orden. 0 = ordenar sin cortar (default); un
# corte en 30 deja fuera la carrera correcta del perfil artístico (medido).
HOLLAND_TOP=0

# --- Registro de administración (app/auth.py, GET /api/admin/respuestas) ---
# Correos de Google con acceso al registro de evaluaciones (/admin en la web),
# separados por coma. Vacío o sin la variable = nadie entra, que es el default
# seguro. El correo lo verifica Google en el login, no se teclea en la app.
ADMIN_EMAILS=

# EXPERIMENTAL, apagado. Con 1, el prompt de la recomendación recibe además
# instrucciones sobre qué hacer con la edad, el grado y la carrera cursada.
# Medido DOS veces: no mejora y una vez rompió un caso. Ver
# experiments/edad-y-grado.md.
EDAD_Y_GRADO_EN_RECOMENDACION=0

# Cache explicito de Gemini (caches.create). APAGADO por defecto: alquila
# almacenamiento por hora y solo conviene con trafico concentrado (una clase de
# muchos alumnos en la misma hora amortiza el alquiler). Con trafico goteado
# sale mas caro que mandar todo inline, y en =0 se usa el cache IMPLICITO, que
# es automatico y sin alquiler. Encenderlo (=1) solo el dia de la clase, junto
# con la key de billing. Ver experiments/cache-compartido.md.
CACHE_EXPLICITO=0

# Solo local: permite evaluarse sin iniciar sesion con Google (cae a un alumno
# de prueba, dev@local). En Render NO se define, y ahi el login sigue siendo
# obligatorio. Ver backend/app/auth.py.
LOGIN_OPCIONAL=0
